<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
  The Nutrition and Cooking Timers TitledPanes each wrap an empty VBox
  placeholder (fx:id nutritionContainer / timerContainer). Their actual
  content. a PieChart that redraws on every servings change, and a
  list of independently-ticking timer rows is built and swapped in
  by RecipeDetailController at runtime (see ui.NutritionChartView and
  ui.TimerPanelView), the same way a ListView's cells are built by a
  cell factory rather than laid out by hand in Scene Builder.
-->

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.recipeplanner.controller.RecipeDetailController">
    <content>
        <VBox spacing="18">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>

            <HBox spacing="20">
                <ImageView fx:id="imageView" fitHeight="240" fitWidth="360" preserveRatio="false" />
                <VBox spacing="6">
                    <padding>
                        <Insets left="20" />
                    </padding>
                    <Label fx:id="titleLabel" style="-fx-font-size: 22px; -fx-font-weight: bold;" />
                    <Label fx:id="categoryLabel" styleClass="card-subtitle" />
                    <HBox spacing="10">
                        <Button fx:id="favoriteButton" onAction="#onToggleFavorite" styleClass="primary-button" />
                        <Button onAction="#onEnterCookMode" styleClass="primary-button" text="Enter Cook Mode" />
                        <Button onAction="#onEditNutrition" text="Edit Nutrition" />
                    </HBox>
                    <Label fx:id="statusLabel" styleClass="status-label" />
                </VBox>
            </HBox>

            <HBox spacing="20">
                <VBox spacing="6">
                    <Label text="Ingredients" />
                    <HBox spacing="8">
                        <Label text="Servings:" />
                        <Spinner fx:id="servingsSpinner" editable="true" prefWidth="90" />
                    </HBox>
                    <ListView fx:id="ingredientList" prefHeight="220" />
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Instructions" />
                    <TextArea fx:id="instructionsArea" editable="false" prefHeight="220" wrapText="true" />
                </VBox>
            </HBox>

            <TitledPane collapsible="false" text="Nutrition">
                <content>
                    <VBox fx:id="nutritionContainer" />
                </content>
            </TitledPane>
            <TitledPane text="Micronutrients (USDA estimate)" collapsible="true">
                <content>
                    <VBox spacing="6">
                        <Label fx:id="micronutrientStatusLabel" styleClass="status-label"/>
                        <ListView fx:id="micronutrientList" prefHeight="160"/>
                    </VBox>
                </content>
            </TitledPane>

            <TitledPane collapsible="false" text="Cooking Timers">
                <content>
                    <VBox fx:id="timerContainer" />
                </content>
            </TitledPane>
        </VBox>
    </content>
</ScrollPane>
